<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": the setup programs of the Windows release job
     (.github/workflows/release.yml), which hold the executables that "executables" signed.
     Paste it into the SignPath project with this slug; SignPath keeps its own copy. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Kodem-windows-*-setup.exe" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
